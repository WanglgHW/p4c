pub fn pipeline(packet: bits[MAX_PACKET_BITS], std_meta: StdMeta, ipv4_lpm_entries: ipv4_lpm_entry_t[MAX_TABLE_ENTRIES]) -> (bits[MAX_PACKET_BITS], StdMeta) {
