pub fn ipv4_forward(headers: Headers, meta: Metadata, std_meta: StdMeta, dstAddr: u48, port: u9) -> (Headers, Metadata, StdMeta) {
    let std_meta = Standard_metadata_t { egress_spec: port, ..std_meta };
    let hdr.ethernet = Ethernet_t { srcAddr: hdr.ethernet.dstAddr, ..hdr.ethernet };
    let hdr = Headers { ethernet: hdr.ethernet, ..hdr };
    let hdr.ethernet = Ethernet_t { dstAddr: dstAddr, ..hdr.ethernet };
    let hdr = Headers { ethernet: hdr.ethernet, ..hdr };
    let hdr.ipv4 = Ipv4_t { ttl: (hdr.ipv4.ttl + u8:255), ..hdr.ipv4 };
    let hdr = Headers { ipv4: hdr.ipv4, ..hdr };
    (headers, meta, std_meta)
}

