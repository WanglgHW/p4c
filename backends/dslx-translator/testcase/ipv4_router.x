                (true, i, headers, meta, std_meta)
            } else {
                (matched, match_idx, headers, meta, std_meta)
            }
        } else {
            (matched, match_idx, headers, meta, std_meta)
        }
    }(((false, u32:0, headers, meta, std_meta)));

    if matched {
